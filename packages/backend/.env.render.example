# =============================================================================
# BACKEND ENVIRONMENT CONFIGURATION - RENDER.COM
# =============================================================================
# ⚠️ Copy this file to `.env.render` (or directly into Render Dashboard) and fill in your values.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED SECRETS
# -----------------------------------------------------------------------------
DJANGO_SECRET_KEY=your_secure_django_secret_key
HASHID_FIELD_SALT=your_secure_hashid_salt

# -----------------------------------------------------------------------------
# DATABASE AND REDIS
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
REDIS_CONNECTION=rediss://default:password@host:port

# -----------------------------------------------------------------------------
# PRE-CONFIGURED & BUG FIXES
# -----------------------------------------------------------------------------
STORAGE_BACKEND=r2
DJANGO_DEBUG=False
ENVIRONMENT_NAME=production
AWS_XRAY_SDK_ENABLED=False
CELERY_TASK_ALWAYS_EAGER=True

# -----------------------------------------------------------------------------
# URLS & CORS
# -----------------------------------------------------------------------------
DJANGO_ALLOWED_HOSTS=your-backend.onrender.com
WEB_APP_URL=https://your-frontend.vercel.app
API_URL=https://your-backend.onrender.com
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
CSRF_TRUSTED_ORIGINS=https://your-frontend.vercel.app,https://your-backend.onrender.com
SOCIAL_AUTH_ALLOWED_REDIRECT_HOSTS=your-frontend.vercel.app

# -----------------------------------------------------------------------------
# CLOUDFLARE R2 STORAGE
# -----------------------------------------------------------------------------
R2_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=saas-media

# -----------------------------------------------------------------------------
# EMAILS
# -----------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_smtp_user
EMAIL_HOST_PASSWORD=your_smtp_password
EMAIL_USE_TLS=True
EMAIL_FROM_ADDRESS=noreply@yourdomain.com

# -----------------------------------------------------------------------------
# PAYMENT BACKEND
# "payfast" (default) or "stripe". With payfast, fill in the PayFast values below;
# until then the startup check reports what is missing.
# Add these to the backend, celery-worker and celery-beat services on Render.
# -----------------------------------------------------------------------------
PAYMENT_BACKEND=payfast

# -----------------------------------------------------------------------------
# PAYFAST PAYMENTS (used when PAYMENT_BACKEND=payfast)
# Two credential sets; ENVIRONMENT_NAME picks one:
#   ENVIRONMENT_NAME=production -> *_PRODUCTION on live PayFast
#   anything else (local, qa)   -> *_DEVELOPMENT on the PayFast sandbox
# Docs: https://developers.payfast.co.za/docs
# -----------------------------------------------------------------------------
# Sandbox (https://sandbox.payfast.co.za): merchant ID/key under SETTINGS, and set
# a "Salt Passphrase" there. Notify URL: the backend's public HTTPS URL, locally
# via `ngrok http 5001`: https://<id>.ngrok-free.app/api/payfast/notify/
PAYFAST_MERCHANT_ID_DEVELOPMENT=
PAYFAST_MERCHANT_KEY_DEVELOPMENT=
PAYFAST_PASSPHRASE_DEVELOPMENT=
PAYFAST_NOTIFY_URL_DEVELOPMENT=

# Live PayFast: merchant ID/key in the PayFast dashboard -> Settings; the passphrase
# must match its "Salt Passphrase". Notify URL: https://<your-backend-host>/api/payfast/notify/
PAYFAST_MERCHANT_ID_PRODUCTION=
PAYFAST_MERCHANT_KEY_PRODUCTION=
PAYFAST_PASSPHRASE_PRODUCTION=
PAYFAST_NOTIFY_URL_PRODUCTION=

# Only accept notifications from PayFast's servers (keep True in production).
PAYFAST_VERIFY_SOURCE_IP=True

# Plan prices and donation amounts in ZAR (PayFast's minimum is 5.00)
PAYFAST_MONTHLY_PRICE=199.00
PAYFAST_YEARLY_PRICE=1990.00
PAYFAST_DONATION_AMOUNTS=50,100,150
